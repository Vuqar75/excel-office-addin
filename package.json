{
  "name": "excel-office-addin",
  "version": "3.4.0",
  "private": true,
  "description": "Office.js Excel task-pane add-in with selected-range analysis",
  "scripts": {
    "build": "webpack --mode production",
    "build:publication": "node scripts/build-publication.mjs",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:release": "node scripts/validate-release.mjs",
    "test": "node scripts/test-all.mjs"
  },
  "dependencies": {
    "@microsoft/office-js": "^1.1.95"
  },
  "devDependencies": {
    "html-webpack-plugin": "^5.6.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^1.13.6",
    "office-addin-manifest": "^1.13.6",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
